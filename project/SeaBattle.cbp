<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="SeaBattle" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="..\bin\Debug\SeaBattle" prefix_auto="1" extension_auto="1" />
				<Option object_output="..\obj\Debug\" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DSEABATTLE_DEBUG" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="..\bin\Release\SeaBattle" prefix_auto="1" extension_auto="1" />
				<Option object_output="..\obj\Release\" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-Wextra" />
			<Add option="-std=c++17" />
			<Add directory="..\include" />
		</Compiler>
		<Linker>
			<Add option="-static" />
		</Linker>
